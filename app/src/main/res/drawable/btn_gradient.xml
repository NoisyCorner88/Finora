<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 1. Mengatur Warna Gradasi Linear dari Kiri ke Kanan -->
    <gradient
        android:startColor="#2563EB"
        android:endColor="#3B82F6"
        android:angle="0"
        android:type="linear" />

    <!-- 2. Mengatur Tingkat Kelengkungan Sudut (Corner Radius) -->
    <!-- Anda bisa menaikkan angkanya (misal 24dp) jika ingin lebih bulat -->
    <corners android:radius="18dp" />

</shape>
