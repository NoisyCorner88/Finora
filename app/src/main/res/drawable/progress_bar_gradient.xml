<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Warna Dasar Belakang (Background Track / Garis Abu-abu saat Kosong) -->
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="10dp" />
            <color android:color="#E2E8F0" />
        </shape>
    </item>

    <!-- 2. Warna Progres Gradasi Biru (Linear Blue Gradient) -->
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape>
                <corners android:radius="10dp" />
                <!-- Mengatur kombinasi warna gradasi linear -->
                <gradient
                    android:startColor="#1D4ED8"
                    android:endColor="#00F2FE"
                    android:angle="0"
                    android:type="linear" />
            </shape>
        </scale>
    </item>

</layer-list>
