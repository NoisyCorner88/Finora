<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgall"
    android:orientation="vertical">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="Kembali"
            android:elevation="2dp"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/pjkt_ebold"
            android:text="Kartu Saya"
            android:textColor="#1555E8"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/btnAddCard"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="Tambah Kartu"
            android:elevation="2dp"
            android:padding="10dp"
            android:src="@drawable/ic_add_circle" />
    </RelativeLayout>

    <!-- Filter Tabs (Cash | Debit | E-Wallet) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_white_card"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selected"
            android:fontFamily="@font/pjkt_ebold"
            android:gravity="center"
            android:text="Semua"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabDebit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/pjkt_ebold"
            android:gravity="center"
            android:text="Debit"
            android:textColor="#667085"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabEWallet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/pjkt_ebold"
            android:gravity="center"
            android:text="E-Wallet"
            android:textColor="#667085"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabCash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/pjkt_ebold"
            android:gravity="center"
            android:text="Cash"
            android:textColor="#667085"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Big Card Preview -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPreviewContainer"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp">

                <RelativeLayout
                    android:id="@+id/cardPreviewBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card_finora"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pjkt_ebold"
                        android:text="◈  FINORA"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvCardTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_card_badge"
                        android:fontFamily="@font/pjkt_ebold"
                        android:paddingStart="12dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="3dp"
                        android:text="DEBIT"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <ImageView
                        android:id="@+id/ivChip"
                        android:layout_width="38dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="34dp"
                        android:src="@drawable/card_ic" />

                    <TextView
                        android:id="@+id/tvCardNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="38dp"
                        android:fontFamily="@font/pjkt_ebold"
                        android:text="••••  ••••  ••••  •821"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_above="@id/tvCardBalance"
                        android:fontFamily="@font/pjkt_reg"
                        android:text="SALDO TERSEDIA"
                        android:textColor="#D0E0FF"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvCardBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:fontFamily="@font/pjkt_ebold"
                        android:text="Rp 8.460.200"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tvBankName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:fontFamily="@font/pjkt_ebold"
                        android:text="UWG"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="italic" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_white_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pjkt_ebold"
                        android:text="INFORMASI REKENING"
                        android:textColor="#667085"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnEditCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="@font/pjkt_ebold"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="✎  Edit Kartu"
                        android:textColor="#1555E8"
                        android:textSize="11sp" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pjkt_reg"
                            android:text="Nama Akun"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvInfoAccountName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/pjkt_ebold"
                            android:text="UWG Debit"
                            android:textColor="#182033"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pjkt_reg"
                            android:text="Nomor Kartu"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvInfoCardNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/pjkt_ebold"
                            android:text="•••• 821"
                            android:textColor="#182033"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pjkt_reg"
                            android:text="Saldo Utama"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvInfoBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/pjkt_ebold"
                            android:text="Rp8.460.200"
                            android:textColor="#1555E8"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- PILIH DOMPET -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pjkt_ebold"
                    android:text="PILIH DOMPET"
                    android:textColor="#182033"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/pjkt_reg"
                    android:text="Sentuh untuk beralih"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </RelativeLayout>

            <!-- Card List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWalletCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
