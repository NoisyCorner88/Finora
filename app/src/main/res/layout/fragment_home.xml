<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="120dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:src="@drawable/logos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/pjkt_ebold"
                    android:text="Finora"
                    android:textColor="#2563EB"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnBell"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_white"
                    android:contentDescription="Notifikasi"
                    android:elevation="2dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_bell" />

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_circle_blue"
                    android:fontFamily="@font/pjkt_ebold"
                    android:gravity="center"
                    android:text="F"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Sapaan -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/pjkt_reg"
            android:text="Selamat pagi ✨"
            android:textColor="#182033"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:fontFamily="@font/pjkt_ebold"
            android:text="Pengguna"
            android:textColor="#1555E8"
            android:textSize="24sp" />

        <!-- Total saldo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_white_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pjkt_reg"
                        android:text="Total Saldo Aktif"
                        android:textColor="#182033"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/btnToggleBalance"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="Tampilkan atau sembunyikan saldo"
                        android:padding="5dp"
                        android:src="@drawable/ic_eye" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/badgeGrowth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_badge_green"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:id="@+id/ivGrowth"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_trending_up" />

                    <TextView
                        android:id="@+id/tvGrowth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/pjkt_ebold"
                        android:text="Rp 0 bln ini"
                        android:textColor="#00A879"
                        android:textSize="10sp" />
                </LinearLayout>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tvTotalBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pjkt_ebold"
                    android:text="Rp 0"
                    android:textColor="#182033"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignBaseline="@id/tvTotalBalance"
                    android:fontFamily="@font/pjkt_reg"
                    android:text="IDR TABUNGAN"
                    android:textColor="#667085"
                    android:textSize="9sp" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Aksi cepat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/actionScan"
                style="@style/QuickAction">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_blue"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_scan_camera" />

                <TextView
                    style="@style/QuickActionLabel"
                    android:text="Scan" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/actionCard"
                style="@style/QuickAction">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_blue_light"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_credit_card" />

                <TextView
                    style="@style/QuickActionLabel"
                    android:text="Kartu" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/actionAnalysis"
                style="@style/QuickAction">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_blue_light"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_assessment" />

                <TextView
                    style="@style/QuickActionLabel"
                    android:text="Analisis" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/actionTransaction"
                style="@style/QuickAction"
                android:layout_marginEnd="0dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_blue_light"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_add_circle" />

                <TextView
                    style="@style/QuickActionLabel"
                    android:text="Transaksi" />
            </LinearLayout>
        </LinearLayout>

        <!-- Kartu saya -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pjkt_ebold"
                android:text="Kartu Saya •"
                android:textColor="#182033"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnManageCards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/pjkt_ebold"
                android:text="Kelola"
                android:textColor="#2563EB"
                android:textSize="12sp" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Transaksi terbaru -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="14dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pjkt_ebold"
                    android:text="Transaksi Terbaru"
                    android:textColor="#182033"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/pjkt_ebold"
                    android:text="Riwayat"
                    android:textColor="#2563EB"
                    android:textSize="12sp" />
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <TextView
                android:id="@+id/tvEmptyTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pjkt_reg"
                android:gravity="center"
                android:padding="24dp"
                android:text="Belum ada transaksi.\nKetuk tombol + untuk mencatat transaksi pertama."
                android:textColor="#667085"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
