<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_white_card"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <View
        android:id="@+id/viewColorPill"
        android:layout_width="10dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_circle_blue" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWalletName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pjkt_ebold"
            android:text="UWG Pay"
            android:textColor="#182033"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvWalletTypeNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/pjkt_reg"
            android:text="Debit • •••• 821"
            android:textColor="#667085"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWalletBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pjkt_ebold"
            android:text="Rp 8.460.200"
            android:textColor="#1555E8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvWalletSelectedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/pjkt_ebold"
            android:text="✔ Dipilih"
            android:textColor="#00A879"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
