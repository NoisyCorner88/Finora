<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="120dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Top bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:fontFamily="@font/pjkt_ebold"
                android:text="Statistik"
                android:textColor="#182033"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvAvatarStats"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_blue"
                android:elevation="2dp"
                android:fontFamily="@font/pjkt_ebold"
                android:gravity="center"
                android:text="B"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </RelativeLayout>

        <!-- Filter periode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_white_card"
            android:elevation="2dp"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/pillThisMonth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/pjkt_ebold"
                android:gravity="center"
                android:text="Bulan Ini"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/pillLastMonth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/pjkt_ebold"
                android:gravity="center"
                android:text="Bulan Lalu"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/pillAllTime"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/pjkt_ebold"
                android:gravity="center"
                android:text="Semua"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPeriodLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/pjkt_reg"
            android:textColor="#667085"
            android:textSize="12sp" />

        <!-- Ringkasan arus kas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_white_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pjkt_reg"
                android:text="Selisih Pemasukan &#8211; Pengeluaran"
                android:textColor="#667085"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvNet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/pjkt_ebold"
                android:maxLines="1"
                android:text="Rp 0"
                android:textColor="#182033"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tvNetHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/pjkt_reg"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_circle_blue_light"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        android:fontFamily="@font/pjkt_reg"
                        android:text="&#9650; Pemasukan"
                        android:textColor="#00A879"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvIncome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/pjkt_ebold"
                        android:maxLines="1"
                        android:text="Rp 0"
                        android:textColor="#182033"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_circle_blue_light"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pjkt_reg"
                        android:text="&#9660; Pengeluaran"
                        android:textColor="#FF253B"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvExpense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/pjkt_ebold"
                        android:maxLines="1"
                        android:text="Rp 0"
                        android:textColor="#182033"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Anggaran -->
        <LinearLayout
            android:id="@+id/cardBudget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_white_card"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvBudgetLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/tvBudgetRemaining"
                    android:ellipsize="end"
                    android:fontFamily="@font/pjkt_ebold"
                    android:maxLines="1"
                    android:textColor="#182033"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvBudgetRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/pjkt_ebold"
                    android:textColor="#1555E8"
                    android:textSize="12sp" />
            </RelativeLayout>

            <ProgressBar
                android:id="@+id/progressBudget"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressDrawable="@drawable/progress_bar_gradient" />

            <TextView
                android:id="@+id/tvBudgetPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/pjkt_reg"
                android:textColor="#667085"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Grafik batang -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_white_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvChartTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/pjkt_ebold"
                    android:text="Tren Mingguan"
                    android:textColor="#182033"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTrendBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_badge_green"
                    android:fontFamily="@font/pjkt_ebold"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="#00A879"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pjkt_reg"
                    android:text="&#9679; Pemasukan"
                    android:textColor="#00A879"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/pjkt_reg"
                    android:text="&#9679; Pengeluaran"
                    android:textColor="#FF253B"
                    android:textSize="10sp" />
            </LinearLayout>

            <com.ncp.finora.ui.stats.BarChartView
                android:id="@+id/barChart"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvChartDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/pjkt_reg"
                android:gravity="center"
                android:textColor="#667085"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Per kategori -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_white_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvCategoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pjkt_ebold"
                android:text="Pengeluaran per Kategori"
                android:textColor="#182033"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipCatExpense"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:fontFamily="@font/pjkt_ebold"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Pengeluaran"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipCatIncome"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/pjkt_ebold"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Pemasukan"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.ncp.finora.ui.stats.DonutChartView
                android:id="@+id/donutChart"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <TextView
                android:id="@+id/tvEmptyStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pjkt_reg"
                android:gravity="center"
                android:padding="16dp"
                android:text="Belum ada data untuk periode ini"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
