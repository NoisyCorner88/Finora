<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="120dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Top Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:fontFamily="@font/pjkt_ebold"
                android:text="Aktivitas"
                android:textColor="#182033"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvActivityMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_white_card"
                    android:elevation="2dp"
                    android:fontFamily="@font/pjkt_ebold"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="Oktober 2026 ∨"
                    android:textColor="#182033"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvAvatarActivity"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_circle_blue"
                    android:elevation="2dp"
                    android:fontFamily="@font/pjkt_ebold"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Calendar Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_white_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Navigasi bulan -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="&#8249;"
                    android:textColor="#1555E8"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tvCalendarMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/pjkt_ebold"
                    android:textColor="#182033"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnNextMonth"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="&#8250;"
                    android:textColor="#1555E8"
                    android:textSize="26sp" />
            </RelativeLayout>

            <!-- Weekdays -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView style="@style/CalendarDayHeader" android:text="SEN" />
                <TextView style="@style/CalendarDayHeader" android:text="SEL" />
                <TextView style="@style/CalendarDayHeader" android:text="RAB" />
                <TextView style="@style/CalendarDayHeader" android:text="KAM" />
                <TextView style="@style/CalendarDayHeader" android:text="JUM" />
                <TextView style="@style/CalendarDayHeader" android:text="SAB" />
                <TextView style="@style/CalendarDayHeader" android:text="MIN" />
            </LinearLayout>

            <!-- Grid tanggal (dinamis) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/tvSelectedDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_circle_blue_light"
                android:fontFamily="@font/pjkt_ebold"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="#1555E8"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Summary Row (Pengeluaran & Pemasukan) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Pengeluaran -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_white_card"
                android:elevation="2dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_expense"
                    android:padding="6dp"
                    android:rotation="90"
                    android:src="@drawable/ic_trending_up"
                    app:tint="#FF253B" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pjkt_reg"
                        android:text="Pengeluaran"
                        android:textColor="#667085"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvActivityExpense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/pjkt_ebold"
                        android:text="Rp 2.663.000"
                        android:textColor="#182033"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pemasukan -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_white_card"
                android:elevation="2dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_income"
                    android:padding="6dp"
                    android:src="@drawable/ic_trending_up"
                    app:tint="#00A879" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pjkt_reg"
                        android:text="Pemasukan"
                        android:textColor="#667085"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvActivityIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/pjkt_ebold"
                        android:text="Rp 13.650.000"
                        android:textColor="#00A879"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Section: Pengeluaran per Kategori -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pjkt_ebold"
                android:text="Riwayat Transaksi"
                android:textColor="#182033"
                android:textSize="14sp" />
        </RelativeLayout>

        <!-- Filter Chips (Semua | Pemasukan | Pengeluaran) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_selected"
                android:fontFamily="@font/pjkt_ebold"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="Semua"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:fontFamily="@font/pjkt_ebold"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="Pemasukan"
                android:textColor="#1555E8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipExpense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:fontFamily="@font/pjkt_ebold"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="Pengeluaran"
                android:textColor="#1555E8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Transactions RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            android:id="@+id/tvEmptyActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/pjkt_reg"
            android:gravity="center"
            android:text="Belum ada transaksi"
            android:textColor="#667085"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
